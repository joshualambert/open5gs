logger:
  file:
    path: @localstatedir@/log/open5gs/upf.log
#  level: info   # fatal|error|warn|info(default)|debug|trace

global:
  max:
    ue: 1024  # The number of UE can be increased depending on memory size.
#    peer: 64

upf:
  pfcp:
    server:
      - address: 127.0.0.7
    client:
#      smf:     #  UPF PFCP Client try to associate SMF PFCP Server
#        - address: 127.0.0.4
  gtpu:
    server:
      - address: 127.0.0.7
  session:
    - subnet: 10.45.0.0/16
      gateway: 10.45.0.1
    - subnet: 2001:db8:cafe::/48
      gateway: 2001:db8:cafe::1
# Uncomment to hand every session a /56 network prefix ("block") instead of
# a single /64: the lowest /64 of the block is the UE link prefix and the rest
# is delegated to the UE with DHCPv6-PD (RFC 8415). Must be 1..63 and not
# shorter than the subnet; it reduces the pool to one session per /56.
#      prefix_delegation: 56
#
# A subnet reserved for subscribers with a static UE address (WebUI "UE IPv4
# / IPv6 Address"): no dynamic pool is generated, an address is only ever
# placed here when this subnet contains it. Because the operator does not
# put an address covering every static block on the tun device, the UPF
# installs a kernel route per session (Linux rtnetlink, protocol 250) for the
# UE address (/32) or IPv6 block (/prefix_delegation) via `dev` when the
# session is created and removes it with the session; every leftover route
# with protocol 250 is flushed at start-up. Framed routes get a kernel route
# the same way on every subnet. Inspect with `ip -6 route show proto 250`
# (`ip route show proto 250` for IPv4). Requires CAP_NET_ADMIN; without it
# each route is logged as an error and has to be added by hand.
#    - subnet: 2001:db8:beef::/48
#      dev: ogstun2
#      prefix_delegation: 56
#      static: true
  metrics:
    server:
      - address: 127.0.0.7
        port: 9090

################################################################################
# PFCP Server
################################################################################
# o Override PFCP address to be advertised to SMF in PFCP association
#  pfcp:
#    server:
#      - dev: eth0
#        advertise: open5gs-upf.svc.local
#
################################################################################
# GTP-U Server
################################################################################
#  o Override SGW-U GTP-U address to be advertised inside S1AP messages 
#  gtpu:
#    server:
#      - dev: ens3
#        advertise: upf1.5gc.mnc001.mcc001.3gppnetwork.org
#
#  o User Plane IP Resource information
#  gtpu:
#    server:
#      - address:
#        - 127.0.0.7
#        - ::1
#        teid_range_indication: 4
#        teid_range: 10
#        network_instance: internet
#        source_interface: 0
#      - address: 127.0.10.4
#        teid_range_indication: 4
#        teid_range: 5
#        network_instance: ims
#        source_interface: 1
#
################################################################################
# 3GPP Specification
################################################################################
#
#  o Specific DNN/APN(e.g 'ims') uses 10.46.0.1/16, 2001:db8:babe::1/48
#  $ sudo ip addr add 10.45.0.1/16 dev ogstun
#  $ sudo ip addr add 2001:db8:cafe::1/48 dev ogstun2
#  $ sudo ip addr add 10.46.0.1/16 dev ogstun3
#  $ sudo ip addr add 2001:db8:babe::1/48 dev ogstun3
#
#  session:
#    - subnet: 10.45.0.0/16
#      gateway: 10.45.0.1
#      dnn: internet
#    - subnet: 2001:db8:cafe::/48
#      dnn: internet
#      dev: ogstun2
#    - subnet: 10.46.0.0/16
#      gateway: 10.46.0.1
#      dnn: ims
#      dev: ogstun3
#    - subnet: 2001:db8:babe::/48
#      dnn: ims
#      dev: ogstun3
#
#  o Subnet selection
#   An address handed over by the SMF is attached to the subnet of the DNN
#   whose network contains it: 'static: true' subnets are tried before the
#   dynamic ones, and within each group subnets with a matching 'dnn' before
#   subnets without 'dnn', each in the order listed here. The subnet decides
#   the 'dev' the traffic leaves on. If no subnet of the DNN contains the
#   address the session is rejected. Addresses allocated by the UPF itself
#   come from the first dynamic subnet of the DNN (matching 'dnn' first,
#   then without 'dnn') that still has a free entry, so a DNN may list
#   several non-contiguous pools.
#
#  o Static-only subnet
#   'static: true' declares a subnet without a dynamic pool; it is only used
#   for static subscriber addresses inside it (with its own
#   'prefix_delegation', 'gateway' optional) and the UPF installs a kernel
#   route for each such session towards 'dev'. It may be nested inside a
#   dynamic subnet and may be listed under several DNNs with different
#   'dev's.
#  session:
#    - subnet: 2001:db8:cafe::/48
#      gateway: 2001:db8:cafe::1
#      prefix_delegation: 56
#      dev: ogstun2
#    - subnet: 2001:db8:e1::/48
#      prefix_delegation: 56
#      dev: ogstun2
#      static: true
